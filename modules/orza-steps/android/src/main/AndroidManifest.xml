<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Step counting with the phone's own hardware step counter (Sensor.TYPE_STEP_COUNTER). Android 10+ asks the member
       for "Physical activity" at run time (the app requests it from JS with PermissionsAndroid). -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Phones without a step counter can still install ÖRZA (Today then falls back to Health Connect / typing). -->
  <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

  <application>
    <!-- The sampler's own alarms (about hourly + just before and after midnight), through our PendingIntents only. -->
    <receiver
      android:name="expo.modules.orzasteps.StepAlarmReceiver"
      android:enabled="true"
      android:exported="false" />

    <!-- Re-arms the sampler and takes a baseline sample after a reboot / app update, moves the midnight samples after a
         clock or time-zone change, and takes a last sample when the phone shuts down (the counter restarts from 0 at
         boot). Exported so system / OEM broadcasts always arrive; nothing is read from the intent except its action.
         ACTION_SHUTDOWN only reaches manifest receivers below Android 9 (newer: the receiver registered at run time).
         QUICKBOOT_POWERON isn't protected, so it only re-arms missing alarms (no sample); the unprotected QUICKBOOT
         power-off actions are not listened to (a fast "power off" doesn't reset the counter). -->
    <receiver
      android:name="expo.modules.orzasteps.StepBootReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.ACTION_SHUTDOWN" />
      </intent-filter>
    </receiver>

    <!-- Health Connect's "privacy policy" link opens ÖRZA's privacy policy (HealthPrivacyActivity: a WebView on the same
         page as the Play Console's privacy URL). Android 9–13: Health Connect starts the rationale action; Android 14+:
         the system starts the VIEW_PERMISSION_USAGE alias, which only it may (START_VIEW_PERMISSION_USAGE). Replaces the
         react-native-health-connect config plugin, which pointed both at MainActivity (Today). -->
    <activity
      android:name="expo.modules.orzasteps.HealthPrivacyActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>
    <activity-alias
      android:name="expo.modules.orzasteps.ViewPermissionUsageActivity"
      android:exported="true"
      android:targetActivity="expo.modules.orzasteps.HealthPrivacyActivity"
      android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>
  </application>
</manifest>
