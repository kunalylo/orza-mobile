# ÖRZA API origin (the web app). Inlined at build time; eas.json sets it per build profile.
# Development builds REQUIRE it — they never fall back to the live site ("API URL not configured" screen).
# Emulator testing against the local web test server: .env.local with EXPO_PUBLIC_API_URL=http://10.0.2.2:3100
# (Android emulator; iOS simulator: http://localhost:3100).
EXPO_PUBLIC_API_URL=https://orza-nine.vercel.app
